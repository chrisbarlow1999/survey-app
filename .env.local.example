# Copy this file to .env.local and fill in your real values.
# Find both in Supabase: Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# SUPABASE_SERVICE_ROLE_KEY: Supabase → Project Settings → API Keys → "service_role" secret.
#   NEVER prefix this with NEXT_PUBLIC_ — it must stay server-only.
#   Required for /admin → Create Account (creating a login account is a
#   privileged operation the publishable key can't do). Also used by the
#   optional email notifications below.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: survey/install submission email notifications ---
# Leave these unset and notifications simply don't send — nothing else breaks.
# RESEND_API_KEY: from resend.com after creating a free account + API key.
# NOTIFY_FROM_EMAIL: the "from" address for notification emails. Resend's
#   onboarding@resend.dev works for testing; once you verify your own domain
#   in Resend, switch this to something like surveys@yourcompany.com.
# NEXT_PUBLIC_APP_URL: your site's URL (e.g. https://your-app.vercel.app), used
#   to build the "view it" link in notification emails. Leave unset locally.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=onboarding@resend.dev
NEXT_PUBLIC_APP_URL=
